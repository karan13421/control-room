# Dev image: Vite's dev server against source mounted from the host, with
# hot module reload. Not used for deployment — the repo-root Dockerfile
# builds the production bundle instead.
FROM node:22-alpine
WORKDIR /web
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
EXPOSE 5173
# --host so the dev server is reachable through Docker's port mapping - by
# default Vite binds localhost only, which the container's loopback keeps
# unreachable from the host even with -p published.
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
